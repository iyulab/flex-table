{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ⚠형제 13개 중 11개가 `ESNext` 다 — 이 패키지와 `u-widgets` 만 `ES2021` 이었다.
    //   `@iyulab/components` 를 «소스로» 타입 시야에 들이는 순간(워크스페이스 링크는
    //   `src` 를 본다) 그쪽이 쓰는 `Array.prototype.at`(ES2022)가 `TS2550` 로 막는다.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    // ⚠TypeScript 6 은 typeRoots 의 `@types/*` 를 «전부» 자동 포함하지 않는다(5.9 는 했다).
    // 이 패키지는 `src/styles/*.test.ts` 가 `fs`·`path`·`__dirname` 을 쓰므로 명시해야 한다
    // — 빼면 TS2591/TS2304 8건(cycle-475 네거티브 컨트롤로 확인).
    "types": ["node", "vite/client"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "demo"]
}
