{
  "name": "@iyulab/flex-table",
  "version": "0.79.0",
  "description": "A minimalist, input-centric data grid web component",
  "type": "module",
  "main": "./dist/flex-table.js",
  "module": "./dist/flex-table.js",
  "types": "./dist/index.d.ts",
  "customElements": "./dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/flex-table.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./odata": {
      "types": "./dist/odata/index.d.ts",
      "import": "./dist/odata/index.js"
    },
    "./array": {
      "types": "./dist/array/index.d.ts",
      "import": "./dist/array/index.js"
    }
  },
  "sideEffects": [
    "./src/flex-table.ts",
    "./dist/*.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.test.d.ts",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "dev": "vite serve demo",
    "analyze": "cem analyze",
    "build": "npm run typecheck && vite build && tsc --emitDeclarationOnly && npm run analyze",
    "build:demo": "vite build --config vite.config.demo.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "pretest": "node -e \"if(require('fs').existsSync('../../scripts/sibling-dist-check.js'))require('child_process').execFileSync('node',['../../scripts/sibling-dist-check.js'],{stdio:'inherit'})\"",
    "test": "vitest run --project=unit --project=browser",
    "test:webkit": "vitest run --project=webkit",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "web-component",
    "data-grid",
    "table",
    "lit",
    "spreadsheet"
  ],
  "license": "MIT",
  "author": "iyulab",
  "homepage": "https://github.com/iyulab/flex-table#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/flex-table.git"
  },
  "bugs": {
    "url": "https://github.com/iyulab/flex-table/issues"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "odata-query": "^8.1.0"
  },
  "peerDependencies": {
    "@iyulab/components": ">=3.1.0",
    "@lit/react": "^1.0.8",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@iyulab/components": "^3.0.0",
    "@lit/react": "^1.0.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
